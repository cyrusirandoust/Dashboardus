# Azure AD Configuration
# Get these values from your Azure App Registration
VITE_AAD_CLIENT_ID=your-client-id-here
VITE_AAD_TENANT_ID=your-partner-tenant-id-here

# Optional: Use 'common' for multi-tenant, or specific tenant ID for single-tenant
# VITE_AAD_AUTHORITY=https://login.microsoftonline.com/common

# Dashboard Configuration
# Refresh interval in milliseconds (default: 5 minutes = 300000ms)
VITE_DEFAULT_REFRESH_INTERVAL=300000

# Enable live mode feature (60-second refresh for incidents)
VITE_ENABLE_LIVE_MODE=true

# Auto-lock timeout in milliseconds (default: 10 minutes = 600000ms)
VITE_AUTO_LOCK_TIMEOUT=600000

# Enable PII anonymization by default (for public displays)
VITE_DEFAULT_ANONYMIZE_PII=false